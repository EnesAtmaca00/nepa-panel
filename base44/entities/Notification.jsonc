{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "send_at": {
      "type": "string",
      "format": "date-time"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "in_app"
      ]
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title"
  ]
}