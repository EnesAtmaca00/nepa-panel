{
  "name": "Medication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "dosage": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "schedule_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "default": "#f97316"
    },
    "icon": {
      "type": "string",
      "default": "\ud83d\udc8a"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}