{
  "name": "Expense",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "subscription",
        "salary",
        "office",
        "marketing",
        "software",
        "tax",
        "other"
      ],
      "default": "other"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "quarterly"
      ]
    },
    "next_payment_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "pending"
      ],
      "default": "pending"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "amount"
  ]
}