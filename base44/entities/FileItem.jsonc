{
  "name": "FileItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "drive_file_id": {
      "type": "string"
    },
    "drive_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_kb": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_analyzed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_id",
    "filename"
  ]
}