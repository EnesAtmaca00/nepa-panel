# Şablon — gerçek değer İÇERMEZ, commit edilir.
# Kendi değerlerini .env.local'a yaz (o dosya .gitignore'da).
#
# Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google ile giriş düğmesini göstermek için (Supabase'de Google sağlayıcısı
# yapılandırıldıktan sonra). Boş/false bırakılırsa düğme görünmez.
VITE_GOOGLE_LOGIN=false
